Grammar

    0 $accept: program $end

    1 program: item_list

    2 item_list: item_list item
    3          | ε

    4 item: declaration
    5     | statement
    6     | ';'

    7 opt_semi: ';'
    8         | ε

    9 declaration: variable_declaration
   10            | struct_declaration
   11            | function_declaration

   12 variable_declaration: LET IDENTIFIER '=' expression opt_semi
   13                     | VAR IDENTIFIER '=' expression opt_semi
   14                     | LET IDENTIFIER ':' type_spec '=' expression opt_semi
   15                     | VAR IDENTIFIER ':' type_spec '=' expression opt_semi
   16                     | VAR IDENTIFIER ':' type_spec opt_semi
   17                     | LET IDENTIFIER ':' type_spec opt_semi

   18 type_spec: TYPE_INT_KW
   19          | TYPE_DOUBLE_KW
   20          | TYPE_BOOL_KW
   21          | TYPE_CHAR_KW
   22          | TYPE_STRING_KW
   23          | TYPE_VOID_KW
   24          | '[' type_spec ']'
   25          | IDENTIFIER

   26 struct_declaration: STRUCT IDENTIFIER '{' struct_members '}' opt_semi

   27 struct_members: struct_members struct_member
   28               | struct_member

   29 struct_member: VAR IDENTIFIER ':' type_spec opt_semi
   30              | LET IDENTIFIER ':' type_spec opt_semi

   31 $@1: ε

   32 function_declaration: FUNC IDENTIFIER '(' opt_parameters ')' ARROW type_spec $@1 '{' statements '}' opt_semi

   33 $@2: ε

   34 function_declaration: FUNC IDENTIFIER '(' opt_parameters ')' $@2 '{' statements '}' opt_semi

   35 opt_parameters: parameters
   36               | ε

   37 parameters: parameters ',' parameter
   38           | parameter

   39 parameter: IDENTIFIER ':' type_spec
   40          | IDENTIFIER IDENTIFIER ':' type_spec

   41 statements: statements statement
   42           | ε

   43 statement: assignment opt_semi
   44          | if_statement
   45          | switch_statement
   46          | while_statement
   47          | repeat_while_statement opt_semi
   48          | for_in_statement
   49          | return_statement opt_semi
   50          | print_statement opt_semi
   51          | variable_declaration
   52          | expression opt_semi
   53          | ';'

   54 assignment: IDENTIFIER '=' expression
   55           | IDENTIFIER '[' expression ']' '=' expression
   56           | IDENTIFIER '.' IDENTIFIER '=' expression

   57 print_statement: PRINT '(' expression ')'

   58 return_statement: RETURN expression
   59                 | RETURN

   60 if_header: IF expression

   61 $@3: ε

   62 if_statement: if_header '{' $@3 statements '}'

   63 $@4: ε

   64 @5: ε

   65 if_statement: if_header '{' $@4 statements '}' ELSE @5 '{' statements '}'

   66 $@6: ε

   67 switch_statement: SWITCH expression '{' $@6 switch_cases '}'

   68 switch_cases: switch_cases switch_case
   69             | switch_case

   70 @7: ε

   71 switch_case: CASE expression ':' @7 statements
   72            | DEFAULT ':' statements

   73 @8: ε

   74 while_header: WHILE @8 expression

   75 $@9: ε

   76 while_statement: while_header '{' $@9 statements '}'

   77 repeat_header: REPEAT

   78 $@10: ε

   79 repeat_while_statement: repeat_header '{' $@10 statements '}' WHILE expression

   80 @11: ε

   81 for_in_statement: FOR IDENTIFIER IN expression DOTDOTDOT expression @11 '{' statements '}'

   82 @12: ε

   83 for_in_statement: FOR IDENTIFIER IN IDENTIFIER @12 '{' statements '}'

   84 expression: literal
   85           | IDENTIFIER
   86           | array_access
   87           | field_access
   88           | array_literal
   89           | call_or_init
   90           | '(' expression ')'
   91           | expression '+' expression
   92           | expression '-' expression
   93           | expression '*' expression
   94           | expression '/' expression
   95           | expression '%' expression
   96           | expression EQ expression
   97           | expression NE expression
   98           | expression LT expression
   99           | expression GT expression
  100           | expression LE expression
  101           | expression GE expression
  102           | expression AND expression
  103           | expression OR expression
  104           | NOT expression
  105           | '-' expression

  106 literal: INT_LITERAL
  107        | DOUBLE_LITERAL
  108        | BOOL_LITERAL
  109        | CHAR_LITERAL
  110        | STRING_LITERAL

  111 array_literal: '[' arguments ']'

  112 array_access: IDENTIFIER '[' expression ']'

  113 field_access: IDENTIFIER '.' IDENTIFIER

  114 call_or_init: IDENTIFIER '(' opt_arguments ')'

  115 opt_arguments: arguments
  116              | ε

  117 arguments: arguments ',' argument
  118          | argument

  119 argument: IDENTIFIER ':' expression
  120         | expression


